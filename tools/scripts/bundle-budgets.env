# Single source of truth for the gzip bundle budgets (kB). Sourced by
# check-bundle-budget.sh; docs/performance.md and the app CLAUDE.md files are
# checked against it by tools/scripts/lib/bundle-budgets.test.mjs.
SPOTLIGHT_EAGER_JS_KB=116
SPOTLIGHT_INDEX_CSS_KB=17
BACKSTAGE_EAGER_JS_KB=166
BACKSTAGE_INDEX_CSS_KB=15
ROUTE_CHUNK_KB=40
# Lazy chunks that knowingly exceed ROUTE_CHUNK_KB, as <app>:<chunk>:<ceiling kB>.
# Every entry must match a built chunk (a stale one fails the gate) and carries
# its own ceiling, so growth stays a conscious decision. Rationale per entry:
# docs/performance.md.
ROUTE_CHUNK_EXCEPTIONS="spotlight:site-data:50 backstage:qr-scanner:125"
