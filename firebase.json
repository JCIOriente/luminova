{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": [
    {
      "target": "default",
      "rules": "storage.rules"
    }
  ],
  "functions": [
    {
      "source": "apps/beacon/dist",
      "codebase": "beacon",
      "runtime": "nodejs24",
      "ignore": ["node_modules", ".git"],
      "predeploy": ["pnpm turbo run build --filter beacon"]
    }
  ],
  "hosting": [
    {
      "target": "spotlight",
      "public": "apps/spotlight/dist",
      "predeploy": ["pnpm -s brand:assert-dist spotlight"],
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [{ "source": "/programas", "destination": "/impacto", "type": 301 }],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        {
          "source": "/assets/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "/workbox-*.js",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "**/manifest.webmanifest",
          "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
        }
      ]
    },
    {
      "target": "backstage",
      "public": "apps/backstage/dist",
      "predeploy": ["pnpm -s brand:assert-dist backstage"],
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        {
          "source": "/assets/**",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "/workbox-*.js",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
          "source": "**/manifest.webmanifest",
          "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
        }
      ]
    }
  ],
  "emulators": {
    "auth": { "port": 4030 },
    "firestore": { "port": 4010 },
    "functions": { "port": 4020 },
    "hosting": { "port": 4000 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true, "port": 4100 },
    "singleProjectMode": true
  }
}
