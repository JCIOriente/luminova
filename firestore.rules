rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function roles() {
      return request.auth.token.get('roles', []);
    }
    function hasAnyRole(rs) {
      return signedIn() && roles().hasAny(rs);
    }
    // Resolved coarse permission set (beacon-minted). `.get(...,[])` so a pre-backfill
    // token without the claim reads as empty (deny) rather than erroring.
    function perms() {
      return request.auth.token.get('perms', []);
    }
    function hasPerm(p) {
      return signedIn() && perms().hasAny([p]);
    }
    // Coarse CRUD gate: manage:all (Admin) covers everything; manage:<subject>
    // covers all actions on that subject; else the exact action:subject code.
    function canDo(action, subject) {
      return hasPerm('manage:all')
        || hasPerm('manage:' + subject)
        || hasPerm(action + ':' + subject);
    }
    function unchanged(field) {
      // .get(...) so an ABSENT field (e.g. uid on an un-invited member) compares as
      // null instead of throwing "Property is undefined" — which denied every update
      // to a member without a uid. Immutability holds: null != a set value.
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }
    // Block client-side resurrection of soft-deleted docs: once deletedAt is set
    // it is immutable, and active can only transition true -> false, never back.
    //
    // The three leading conjuncts are a WELL-FORMEDNESS prefix (B), the same one
    // roleLifecycleSafe() already carried, and they are a genuine new denial rather than a
    // tidier spelling of an existing one. The tempting argument — "a doc missing `active`
    // already dies, because the bare resource.data.active read errors and an erroring rule
    // denies" — is FALSE for this function: rules are CEL, whose || ABSORBS errors
    // (error || true == true), and that bare read sits on the left of a || whose right side
    // is unchanged(field), which compares .get(…, null) on both sides and yields
    // null == null -> true on an absent key. Measured against the emulator: before this
    // prefix, a members/positions/allies doc missing either field, or holding a non-bool
    // `active`, was freely client-editable. Note the absorption is specific to the ||: the
    // ('active' in d) conjunct below CANNOT be mutation-proven red, because removing it
    // leaves `d.active is bool` reading an absent key inside a pure && chain, where the
    // error does deny. It buys a clean denial, not a guard — recorded so nobody counts it
    // as coverage.
    //
    // What the prefix costs: a legacy doc in any of those shapes becomes admin-SDK-only to
    // edit, with no rules-layer repair for `active` (see the tests). The three create arms
    // are constrained to match, so no NEW doc can enter those shapes. The Admin takedown arm
    // on members deliberately does NOT call this function — it is the only rules-level path
    // that can unpublish such a member, so the requirement lives here in the helper and not
    // on the arms, which would have removed the remedy along with the disease.
    //
    // The one-way semantics below the prefix are UNCHANGED: deletedAt stays immutable once
    // set and active still only goes true -> false. Four collections depend on that
    // (members ×3 lanes, positions, allies); roles deliberately does not, which is why it
    // has roleLifecycleSafe() instead.
    //
    // Which of the three prefix conjuncts a mutation sweep can turn red, measured (each
    // neutralized to `true` in turn, full rules suite re-run):
    //   (d.active is bool)  — RED alone: the three "stored active is a non-bool" tests.
    //   ('deletedAt' in d)  — RED alone: "denies updating a member whose stored doc has no
    //                         deletedAt key". This is the conjunct the || could not reach.
    //   ('active' in d)     — NEVER red (448/448 still green). With it gone, `d.active is
    //                         bool` reads an absent key, that read ERRORS, and unlike the
    //                         deletedAt half there is no || to absorb it — so the rule still
    //                         denies. It buys a clean denial, not a guard. Recorded so
    //                         nobody counts it as coverage (guardrail #6), and kept for the
    //                         same reason roleShapeValid() keeps its four.
    function softDeleteSafe() {
      let d = request.resource.data;
      return ('active' in d) && (d.active is bool) && ('deletedAt' in d)
        && (resource.data.deletedAt == null || unchanged('deletedAt'))
        && (resource.data.active == true || unchanged('active'));
    }
    // The birth state every soft-deletable collection's create arm requires: born live,
    // with an explicit null deletedAt. FOUR arms share it — members, positions, allies
    // (softDeleteSafe lanes) and roles (roleLifecycleSafe) — so it lives here rather than
    // being retyped per arm.
    //
    // Without it a create mints exactly the docs softDeleteSafe()'s well-formedness prefix
    // then refuses to update, i.e. a doc that is admin-SDK-only from birth. It also closes
    // the INACTIVE-vs-MISSING ambiguity on the way in: with the three update-side lanes
    // constrained to match, no NEW doc can enter the legacy shapes those lanes now reject.
    //
    // `.get('active', false) == true` and an explicit `'deletedAt' in` check, not bare
    // reads: a create OMITTING either field must deny CLEANLY, and
    // `.get('deletedAt', null) == null` would let an omission through.
    function bornLive() {
      return request.resource.data.get('active', false) == true
        && ('deletedAt' in request.resource.data)
        && request.resource.data.deletedAt == null;
    }

    // Missing-key-safe comparison (docs created before a field existed).
    function unchangedOrAbsent(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }
    // The initiative's direction: director + co-directors, mirrored to uids by beacon.
    function isDirection() {
      return signedIn() && request.auth.uid in resource.data.get('directionUids', []);
    }
    // directionUids is beacon-written; termId is immutable; once the final report
    // is filed the initiative is CLOSED (Finalizado): the completion trio
    // (finalReport/status/impact) is locked — clearing the report would silently
    // un-confirm awarded points — and so are the roster (director/co-directors/team)
    // and the start/end dates, which must not change on a closed initiative. Mirror
    // of the backstage initiative-form lock; keep the two field sets in lockstep.
    function initiativeWriteSafe() {
      return unchangedOrAbsent('directionUids')
        && unchangedOrAbsent('termId')
        && (resource.data.get('finalReport', null) == null
            || (unchangedOrAbsent('finalReport')
                && unchangedOrAbsent('status')
                && unchangedOrAbsent('impact')
                && unchangedOrAbsent('roster')
                && unchangedOrAbsent('startDate')
                && unchangedOrAbsent('endDate')));
    }

    // Rules derive the current term from request.time.year() (UTC int) so they can
    // locate positions.<term> without iterating map keys — matches the app's
    // currentTermKey() = getUTCFullYear().
    function currentTermKey() {
      return string(request.time.year());
    }
    function assignedTerm() {
      return request.resource.data.get('positions', {}).get(currentTermKey(), {});
    }
    function assignedBySelf() {
      return assignedTerm().get('assignedBy', '') == request.auth.uid;
    }
    function assignedCargoId() {
      return assignedTerm().get('cargoId', null);
    }
    // A null cargoId short-circuits (no get). For a non-null cargoId, get() on a
    // missing position errors → rule denies (fail-closed). Comisión grants are not
    // checked here (rules can't iterate the array) — the beacon trust gate is their backstop.
    function cargoGrantsEmpty() {
      return assignedCargoId() == null
        || get(/databases/$(database)/documents/positions/$(assignedCargoId())).data.grants.size() == 0;
    }
    // The two questions a non-Admin assignment must answer, read off ONE cargo doc — this
    // is the same get() cargoGrantsEmpty() already pays for, with `category` taken from it
    // rather than a second read.
    //   grants.size() == 0    the claims-mint boundary (as cargoGrantsEmpty).
    //   category != 'CEL'     the PUBLICATION boundary. boardGroupFromCategory publishes
    //                         CEL and JDL alike, and boardRank orders CEL by statutory
    //                         title with 'Presidente' at 0 — so a grant-free CEL cargo,
    //                         self-assigned through the members-positions lane, puts its
    //                         holder at the head of the world-readable Directiva as the
    //                         chapter president, with no Admin action in the chain.
    // That was previously argued blocked because "seeded CEL cargos all carry grants" — a
    // claim about DATA, enforced by nothing. The create arm below deliberately still lets an
    // ADMIN mint a grant-free CEL cargo (rules.test.ts creates exactly one, `mint_cel_admin`),
    // and from that moment the data claim is false. This makes the boundary a RULE.
    // JDL stays open: grant-free direcciones are the accepted publication exposure this lane
    // exists to deliver (spec A, owner-op 1). CEL is the executive committee, whose seats are
    // an Admin decision on both ends — the create arm already says so.
    // Assignment only. currentCargoGrantsEmpty() (the cargo being REPLACED) is deliberately
    // NOT category-gated: clearing a member off a grant-free CEL cargo is exposure-reducing,
    // and denying it would strand a takedown behind an Admin.
    function cargoAssignableByNonAdmin() {
      return assignedCargoId() == null
        || nonAdminAssignable(get(/databases/$(database)/documents/positions/$(assignedCargoId())).data);
    }
    function nonAdminAssignable(cargo) {
      return cargo.grants.size() == 0 && cargo.get('category', '') != 'CEL';
    }
    // The OTHER side of cargoGrantsEmpty(): the cargo being REPLACED. assignedCargoId()
    // reads request.resource.data — the post-write cargo — so without this a manage:Member
    // holder could overwrite a president's positions.<term> with a grant-free cargo,
    // claims-sync would resolve grants.length == 0, and the Admin claim would be gone with
    // no way back but the Firebase console. Update-only: create has no prior resource.
    function currentCargoGrantsEmpty() {
      let prior = resource.data.get('positions', {}).get(currentTermKey(), {}).get('cargoId', null);
      return prior == null
        || get(/databases/$(database)/documents/positions/$(prior)).data.grants.size() == 0;
    }
    // "the write changes this field" — deliberately NOT unchanged(): that compares
    // .get(field, null) on both sides, so writing an explicit null onto a doc that lacks
    // the key reads as unchanged and skips the gate, while affectedKeys() counts it as
    // added and forces validation. Use this to gate a shape check, unchanged() to pin a
    // value the writer may not touch at all.
    function touched(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([field]);
    }
    function positionsDelta() {
      return request.resource.data.get('positions', {})
        .diff(resource.data.get('positions', {}))
        .affectedKeys();
    }
    // A positions write is well-formed when the ONLY changed term key is the current
    // one (past terms are read-only for ALL client writes, Admin included — historical
    // edits are an admin-SDK/console op), the writer stamped themselves, and either they
    // are Admin or the assigned cargo confers no power. Restricting to the current term
    // also closes a ride-along: a non-Admin can no longer sneak a power cargo + forged
    // assignedBy under a different term key in the same write. Comisión power grants are
    // not loop-checkable here — the beacon claims-sync trust gate is their backstop.
    function positionsAssignmentSafe() {
      return positionsDelta().hasOnly([currentTermKey()])
        && assignedBySelf()
        && (hasAnyRole(['Admin'])
            || (cargoAssignableByNonAdmin() && currentCargoGrantsEmpty()));
    }
    // Create has no prior resource to diff, so it can't use positionsDelta(); it
    // applies the same self-stamp + power-cargo-Admin-only gate to any positions it
    // writes. Without this a Membership user could create a member with a forged
    // assignedBy = a known Admin's uid + a power cargo; the claims-sync trigger would
    // then honor the grant and mint Admin onto that member's (or the attacker's) uid.
    function createPositionsSafe() {
      return !('positions' in request.resource.data)
        || (assignedBySelf() && (hasAnyRole(['Admin']) || cargoGrantsEmpty()));
    }

    // roleIds + permissionOverrides feed Auth custom claims via the beacon trigger.
    // Only Admin may set or change them — otherwise a Membership user (who may edit
    // members) could self-assign a power-granting custom role or override and have
    // the claims-sync trigger mint those perms. Create has no prior resource, so it
    // forbids the fields outright for non-Admins; update pins them unchanged.
    function createPermissionAssignmentSafe() {
      return hasAnyRole(['Admin'])
        || (!('roleIds' in request.resource.data)
            && !('permissionOverrides' in request.resource.data));
    }
    function updatePermissionAssignmentSafe() {
      return hasAnyRole(['Admin'])
        || (unchanged('roleIds') && unchanged('permissionOverrides'));
    }

    // The invariants EVERY institutional write to a member doc must hold, as one named
    // thing: the claims-mint boundary (roleIds + permissionOverrides via
    // updatePermissionAssignmentSafe, plus uid), publication consent (publicProfile), the
    // points ledger (totalPoints) and the soft-delete/well-formedness contract. Shared by
    // the members update arm and the positions-only lane so the authority can never drift
    // apart again — the same reason canCurateFeatured() exists.
    //
    // publicProfile is member-consent-only: it publishes their face/name to the public
    // Directiva, so an institutional writer may never set or change it — only the
    // owner-only self-lane, or the Admin takedown arm, can. Those two arms are therefore
    // the ones that do NOT call this, each deliberately: the self lane MUST touch
    // publicProfile (it IS the consent path), and the takedown arm must skip
    // softDeleteSafe() (it is the only rules-level way to unpublish a malformed member).
    //
    // touched(), not unchanged(), on both pinned keys: writing an explicit null onto a doc
    // that lacks the key passes a null == null comparison. For uid that null then fails
    // memberDocSchema, dropping the member out of every backstage list with only a
    // console.error.
    //
    // Cheap by construction — token reads and request/resource data only, no cross-document
    // get() — so an arm may put it ahead of anything that does.
    function memberWriteInvariants() {
      return unchanged('totalPoints')
        && !touched('uid')
        && !touched('publicProfile')
        && updatePermissionAssignmentSafe()
        && softDeleteSafe();
    }

    // The completion trio (status + finalReport + impact) is written atomically by the
    // wizard. A status flip to Finalizado missing either the report or the impact would
    // orphan child-activity point confirmation and permanently strand the doc (the trio
    // locks once finalReport is set). Require both in the same write. Create already
    // forbids Finalizado.
    function finalizedRequiresReport() {
      return request.resource.data.get('status', '') != 'Finalizado'
        || (request.resource.data.get('finalReport', null) != null
            && request.resource.data.get('impact', null) != null);
    }
    // The write that first files the report (finalReport null -> set) must stamp
    // finalReport.filedBy as the caller — clients pass it, so pin it to the auth uid
    // for audit integrity. Once filed, initiativeWriteSafe() locks finalReport, so
    // later edits to a completed doc (e.g. an Admin renaming it) never re-enter here.
    function filingReportNow() {
      return resource.data.get('finalReport', null) == null
        && request.resource.data.get('finalReport', null) != null;
    }
    function reportFiledBySelf() {
      return !filingReportNow()
        || request.resource.data.finalReport.get('filedBy', '') == request.auth.uid;
    }

    // Single source of truth for who may curate `featured` — shared by the
    // create and update arms so the authority can never drift apart again.
    //
    // The authority is SPLIT, and each half is the way it is on purpose:
    //  - Admin by ROLE. It is `locked` and undeactivatable, so its name carries none of
    //    the staleness the perm half exists to fix, and adding update:Showcase to a role
    //    whose entire seeded permission set is ["manage:all"] would misrepresent Admin.
    //  - everyone else by exact PERM (update:Showcase, seeded onto ProjectManager). Role
    //    NAMES are the wrong key here: computeMemberRoles is pure over the trusted grants
    //    and reads no role doc, so a DEACTIVATED ProjectManager keeps the name in its
    //    claim — and, under the old `hasAnyRole(['Admin','ProjectManager'])`, kept the
    //    authority. Keying on the perm means deactivating the role revokes curation.
    // `hasPerm`, deliberately NOT `canDo`: canDo would let `manage:all` satisfy this, and
    // manage:all is reachable as a PERM without the Admin role (an Admin-written custom
    // role doc or a permissionOverrides.grant can carry it — roleShapeValid() only
    // requires `permissions is list`). Such a principal already satisfies
    // canDo('update','Project') on the update arm below, so this gate is the ONLY thing
    // stopping them from setting `featured`; canDo would silently delete that boundary. It
    // also keeps the other five *:Showcase codes — manage:Showcase included — inert, so
    // there is no second, undocumented path to curation. A custom role with manage:Project
    // may edit an initiative but must leave `featured` unchanged.
    //
    // Both arms need it: initiativeCreateAllowed is PERM-based (canDo), so a custom role
    // holding create:Project/Program could otherwise create a doc born `featured: true`
    // and reach the public page once finalized — hence its curator-or-featured-false arm.
    // A curator creating it featured is their prerogative and only reaches the public page
    // once finalized (isProjectable).
    function canCurateFeatured() {
      return hasAnyRole(['Admin']) || hasPerm('update:Showcase');
    }
    function initiativeCreateAllowed(subject) {
      return canDo('create', subject)
        && request.resource.data.get('directionUids', []) == []
        && request.resource.data.get('finalReport', null) == null
        && request.resource.data.get('impact', null) == null
        && request.resource.data.get('status', '') != 'Finalizado'
        && (canCurateFeatured()
            || request.resource.data.get('featured', false) == false);
    }
    // `featured` promotes an already-public finalized initiative onto the curated
    // public /programas page — a curation decision, not an editing one. Only a curator
    // may flip it; a direction-only editor (who may otherwise update their own
    // initiative) must leave it unchanged. A pre-feature doc has no `featured` field,
    // which is semantically `false`, so default-to-false on BOTH sides — else a
    // direction editor echoing `featured: false` (the form always sends it) on a legacy
    // doc reads as null!=false and the whole update is denied.
    // Who counts as a curator, and why that authority is split the way it is, lives on
    // canCurateFeatured() above.
    function featuredUpdateSafe() {
      return canCurateFeatured()
        || request.resource.data.get('featured', false) == resource.data.get('featured', false);
    }
    function initiativeUpdateAllowed(subject) {
      return (canDo('update', subject) || isDirection())
        && initiativeWriteSafe()
        && finalizedRequiresReport()
        && reportFiledBySelf()
        && featuredUpdateSafe();
    }

    match /projects/{projectId} {
      // D1 added member-id rosters to projects; restrict to signed-in (was public).
      // C4's Spotlight projection will expose curated public fields, not raw docs.
      allow read: if signedIn();
      allow create: if initiativeCreateAllowed('Project');
      allow update: if initiativeUpdateAllowed('Project');
      allow delete: if false;
    }

    // Every client writer of members.name passes through here — the self lane, the
    // institutional lane and create alike. It is NOT a self-lane concern: the name is copied
    // verbatim into the world-readable boardShowcase projection, so it needs a length ceiling
    // and a character set at the trust boundary. Enforcing it only where the member writes
    // would leave that resting on the admin form's client-side zod, which any direct
    // authenticated write bypasses — a claim that gates nothing (guardrail #6).
    //
    // Mirrors memberName (packages/types/src/member-name.ts) character for character;
    // parseMemberNameGate() parses this function and member-self-lane.rules.test.ts fails if
    // the two drift (rules mirror code — guardrail #2). The form normalizes before writing,
    // so these rules only ever legitimately see a cleaned value — a raw untrimmed or
    // control-character name is denied here rather than repaired.
    function memberNameValid(name) {
      return name is string
        && name.size() >= 3
        && name.size() <= 80
        && name.matches("^[A-Za-zÀ-ÖØ-öø-ÿĀ-ſ]+[.]?(?:[ '-][A-Za-zÀ-ÖØ-öø-ÿĀ-ſ]+[.]?)*$");
    }

    // The self-service lane's whole contract: which keys a member may write on their own
    // doc, and the shape each must have. Both live here, in one place, because
    // packages/types/src/member-self-lane.rules.test.ts parses this function and fails if
    // it drifts from selfProfileSchema (rules mirror code — guardrail #2).
    //
    // Mirrors memberSchema (packages/types/src/member-schema.ts + phone.ts + member-name.ts):
    // the phone is 8 national digits or blank, profession is capped free text, birthdate is
    // a real date. The admin lane is not held to these — it writes them through a form that
    // already validates them, while a self-write is the one path a member reaches without
    // that form. The name is the exception: memberNameValid() binds every lane.
    //
    // Only the keys a write TOUCHES are shape-checked: a member's photo upload must not be
    // denied by a legacy phone value stored before the 8-digit format was enforced.
    function selfProfileValid(changed) {
      let d = request.resource.data;
      // .get(...) everywhere: clearing a field makes it ABSENT, and a bare d.phone would
      // throw (a rule that errors denies), so a cleared optional field must read as blank.
      return changed.hasOnly(['profilePicture', 'name', 'birthdate', 'profession', 'phone', 'publicProfile'])
        && (!changed.hasAny(['profilePicture'])
          || d.get('profilePicture', null) == null || d.profilePicture is string)
        && (!changed.hasAny(['name']) || memberNameValid(d.get('name', '')))
        && (!changed.hasAny(['birthdate']) || d.get('birthdate', null) is timestamp)
        && (!changed.hasAny(['profession'])
          || (d.get('profession', '') is string && d.get('profession', '').size() <= 80))
        && (!changed.hasAny(['phone'])
          || (d.get('phone', '') is string
              && (d.get('phone', '') == '' || d.get('phone', '').matches('^[0-9]{8}$'))))
        && (!changed.hasAny(['publicProfile']) || d.get('publicProfile', false) is bool);
    }

    match /members/{memberId} {
      allow read: if canDo('read', 'Member')
        || (signedIn() && resource.data.uid == request.auth.uid);
      // No client may supply publicProfile at create; the org-wide opt-out DEFAULT is
      // stamped server-side by beacon's onMemberCreated (admin SDK, rules bypassed).
      // What this guard buys, precisely: no client can PICK the value, so a forged doc
      // can't be born published with a value the creator chose, and the flag can only
      // ever be flipped afterwards by its owner (or an Admin turning it off).
      // What it does NOT buy — publication is opt-out by product decision, so the
      // institutional tier can still COMPOSE a publication for a member who never acted:
      // it may set profilePicture and assign a board cargo, and the stamped default
      // supplies the third gate. projectBoard additionally requires a uid, so the member
      // always has a reachable /me opt-out — but they are published before using it.
      // Making publication require a member signal again would mean reverting to opt-in.
      allow create: if canDo('create', 'Member')
        && request.resource.data.totalPoints == 0
        && !('uid' in request.resource.data)
        && !('publicProfile' in request.resource.data)
        && memberNameValid(request.resource.data.get('name', ''))
        && bornLive()
        && createPermissionAssignmentSafe()
        && createPositionsSafe();
      // The institutional (membership-tier) lane. memberWriteInvariants() carries the
      // claims-mint boundary, publication consent, the points ledger and softDeleteSafe().
      // touched('name'): an admin editing only a phone must not be denied by a legacy name
      // stored before this gate existed — an unchanged value is absent from affectedKeys().
      // Setting a name, on any lane, must satisfy it.
      allow update: if canDo('update', 'Member')
        && memberWriteInvariants()
        && (!touched('name') || memberNameValid(request.resource.data.get('name', '')))
        && (!touched('positions') || positionsAssignmentSafe());
      // Takedown-only arm: an Admin may turn publication OFF and nothing else. Needed
      // because publication now defaults on, so a member who has lost account access —
      // or whose data-subject request arrives by email — must be removable by someone
      // other than themselves. Strictly exposure-reducing: `== false` means this arm can
      // never publish anyone, so it confers no new grant.
      // .get(...) per this file's convention: a deleteField() write leaves the key ABSENT,
      // and a bare read would throw rather than deny cleanly.
      allow update: if hasAnyRole(['Admin'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicProfile'])
        && request.resource.data.get('publicProfile', null) == false;
      // Self-service profile (/me): a member owns their photo, their own name and their
      // contact and personal details — the name so a member can correct a typo the
      // membership tier made when enrolling them, without a round trip. Everything else on
      // the doc — email, status, positions, points, roles — is an institutional record only
      // the membership tier writes.
      // .get('uid', '') so a member doc WITHOUT a uid compares false instead of
      // throwing — an erroring allow-rule must not deny an otherwise-valid update.
      // active: a soft-deleted or desafiliado member's record is an institutional
      // archive — softDeleteSafe() alone would still let them keep editing it.
      allow update: if signedIn()
        && resource.data.get('uid', '') == request.auth.uid
        && resource.data.get('active', true) == true
        && selfProfileValid(request.resource.data.diff(resource.data).affectedKeys())
        && softDeleteSafe();
      // Positions-only lane: an org-chart editor who is NOT a member editor. Keyed on
      // update:Position — the same capability that governs the positions CATALOG — and
      // confined to the positions map. The power-cargo restriction is NOT relaxed:
      // positionsAssignmentSafe()'s non-Admin branch still demands
      // cargoAssignableByNonAdmin() && currentCargoGrantsEmpty(), so this principal assigns
      // and clears grant-free cargos only, on BOTH sides of a swap.
      //
      // This lane IS a public publication authority, deliberately, and its ceiling is JDL:
      // grant-free JDL direcciones are board cargos, so its holder can put a member —
      // including themselves — on the world-readable Directiva under a dirección. No claim
      // is minted (claims-sync returns early on grants.length == 0). Accepted, and pinned by
      // a rules test. CEL is NOT in that grant — cargoAssignableByNonAdmin() refuses it
      // whatever its grants, so 'Presidente' at public rank 0 stays an Admin decision.
      //
      // memberWriteInvariants() is implied by hasOnly(['positions']) TODAY and is stated
      // anyway: if hasOnly is ever widened — the obvious future edit is adding a second
      // key — the claims-mint boundary, publication consent and the points ledger must not
      // vanish with it.
      //
      // Ordered cheapest-first on purpose: positionsAssignmentSafe() is the only conjunct
      // here that can issue cross-document get()s (cargoGrantsEmpty /
      // currentCargoGrantsEmpty), so every denial this arm reaches through the token,
      // affectedKeys or the invariants costs zero billed reads.
      allow update: if canDo('update', 'Position')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['positions'])
        && memberWriteInvariants()
        && positionsAssignmentSafe();
      allow delete: if false;
    }

    // grants feed Auth custom claims (K4 trigger) — only Admin may confer power,
    // else ExecutiveCommittee could mint an Admin-granting cargo for itself.
    // Comisiones are chips-only, for EVERY writer (structural invariant, not an
    // authority tier): position-schema already rejects Comision grants client-side,
    // and claims-sync ignores comisión grants — because members.comisionIds is the
    // one grant path these rules cannot loop-check, a power comisión would ride on
    // the shared per-term assignedBy and break the cargo trust gate's assumptions.
    function comisionGrantsEmpty() {
      return request.resource.data.get('category', '') != 'Comision'
        || request.resource.data.get('grants', []) == [];
    }
    // A category that boardGroupFromCategory() publishes — packages/types/src/engine/
    // board-public.ts maps exactly CEL and JDL onto the world-readable Directiva, and
    // boardRank() then orders them (an unknown CEL title sorts last; 'Presidente' is 0).
    // Creating one is a PUBLICATION decision, so it is Admin-only, matching the pin on
    // the update arm below. Non-Admins create comisiones.
    function boardSurfacingCategory() {
      return request.resource.data.get('category', '') in ['CEL', 'JDL'];
    }
    match /positions/{positionId} {
      allow read: if signedIn();
      // Authorization is perm-based; the power-grant authority (who may confer
      // non-empty grants → claims) stays Admin-role-only, as before.
      //
      // boardSurfacingCategory() closes the create-side twin of the update-side
      // `category` pin. Pinning only the update arm left the same outcome reachable one
      // door over: a non-Admin create:Position holder could MINT a fresh
      // { category: 'CEL', title: 'Presidente', grants: [] } cargo — grants-free, so it
      // passes the power-grant check — and self-assign it through the members-positions
      // lane, landing on the public Directiva at rank 0. Seeded CEL cargos all carry
      // grants, which is what made that look blocked; nothing stopped an UNSEEDED one.
      allow create: if canDo('create', 'Position')
        && (hasAnyRole(['Admin']) || (request.resource.data.grants == []
                                      && !boardSurfacingCategory()))
        && bornLive()
        && comisionGrantsEmpty();
      // `category` joins `grants` in the non-Admin pin because it is an authority field,
      // not a label: it decides the public board GROUP and whether comisionGrantsEmpty()
      // applies at all. Without it an update:Position holder could retitle a grant-free
      // Comisión to { category: 'CEL', title: 'Presidente' } and then assign it to
      // themselves through the members-positions lane, landing on the world-readable
      // Directiva with no Admin action anywhere in the chain.
      //
      // The TITLE is pinned with it, on board cargos only — and that is not symmetry for its
      // own sake. boardRank() (packages/types/src/engine/board-public.ts:49-52) is computed
      // from the base TITLE, not the category: CEL_ORDER maps 'Presidente' onto rank 0, and
      // project-board.ts copies `title` verbatim into the world-readable Directiva. So
      // pinning `category` alone left the same outcome one door over: a non-Admin cannot
      // ASSIGN a seeded CEL cargo (they all carry grants) but could RENAME one — retitle the
      // grant-free 'Vicepresidente' to 'Presidente' and the public board shows them first.
      // On a board cargo a title is an authority field; on a comisión it is a label —
      // comisiones never reach boardGroupFromCategory() — so comisión renames stay open,
      // which is the legitimate org-chart-editor use case owner-op 1 describes.
      // `unchanged('category')` is evaluated first, so reading the POST-write category to
      // decide which branch applies cannot be steered by the writer.
      //
      // The escape is `!boardSurfacingCategory()`, NOT a hand-rolled `== 'Comision'`: the two
      // disagree on a doc whose `category` is absent or unrecognized (a legacy doc predating
      // the field). The hand-rolled form treated that as a board cargo and pinned its labels —
      // fail-closed, so never a hole, but over-restrictive on exactly the docs an org-chart
      // editor has the most reason to fix, and a second definition of "is this published"
      // drifting beside the create arm's (guardrail #1). One predicate, both arms.
      allow update: if canDo('update', 'Position')
        && (hasAnyRole(['Admin'])
            || (unchanged('grants')
                && unchanged('category')
                && (!boardSurfacingCategory()
                    || (unchanged('title') && unchanged('titleFemale')))))
        && softDeleteSafe()
        && comisionGrantsEmpty();
      allow delete: if false;
    }

    // Identity fields are set at seed time and never change via a client write —
    // letting a client flip builtIn/builtInKey would let an impostor custom role
    // spoof a built-in key and double-grant perms through the trigger.
    function roleIdentityUnchanged() {
      return unchanged('builtIn') && unchanged('builtInKey') && unchanged('locked');
    }
    // Roles are the ONE collection whose soft-delete is REVERSIBLE: a built-in role
    // must be able to go out of service and come back. softDeleteSafe() is one-way and
    // shared by four other lanes (members ×3, positions, allies), so the roles lane
    // cannot borrow it.
    //
    // softDeleteSafe() has since gained this function's well-formedness prefix
    // (`active` present and a bool, `deletedAt` present), for the reason spelled out
    // below. What must NOT change there is its ONE-WAY semantics:
    // member resurrection is pinned denied in tests/firestore-rules/rules.test.ts
    // ("denies resurrecting a soft-deleted member"). What did NOT come with the prefix is
    // this function's COUPLING half below (active == true => deletedAt == null, plus the
    // request.time stamp): generalizing that would deny every later edit to an existing
    // ghost doc, a shape all four zod schemas accept and which is therefore listed and
    // editable today. Owed its own pass — see docs/specs/position-assignment-lane.md, B.
    //
    // What this closes: this repo's two definitions of "inactive" disagree.
    // roleDefinitionDocSchema requires `active: z.boolean()`, so a malformed doc is
    // dropped by parseDocs and becomes invisible to the UI, while beacon's
    // isActiveRoleDoc reads `active !== false`, so the same doc stays LIVE and keeps
    // minting perms. Both halves of that ghost must be unwritable:
    //   - (d.active is bool): a string "false" is LIVE to isActiveRoleDoc and invisible
    //     to the UI. Only this conjunct catches it once deletedAt is well-formed — a
    //     mutation test pins that ("denies a non-bool active even with a well-formed
    //     deletedAt");
    //   - the active<->deletedAt coupling: active:true + deletedAt set is live to
    //     getAll()'s where and dead to the pipeline — assignable everywhere, minting
    //     nothing, and for a built-in also COVERED, so the seed fallback vanishes too;
    //   - (d.deletedAt is timestamp): the inactive branch accepts an unchanged deletedAt
    //     (see below), and on a doc whose deletedAt is already null that alone would let
    //     active:false through — inactive with no stamp, which the UI reads as still
    //     restorable. This conjunct is what rejects it.
    // The two `in` checks add no authorization outcome IN THIS FUNCTION: reading an absent
    // key errors, and here the erroring read sits in a pure CONJUNCTION, which cannot
    // recover from it — so the rule denies either way and they only buy a clean denial.
    // Don't remove them on a "no test covers it" argument; no test CAN, because nothing
    // becomes allowed.
    //
    // That is a claim about this function's SHAPE, not a general property of rules — under
    // a DISJUNCTION the same bare read is absorbed and denies nothing. Written out in full
    // on softDeleteSafe() above, which is why the `in` prefix (B) and its legacy-doc cost
    // landed there and not here.
    // deletedAt value forgery has no authorization effect (every consumer tests
    // null-ness only, never ordering); `== request.time` is audit hygiene on the
    // DEACTIVATING write. It cannot be required of every write that merely leaves the
    // doc inactive: RoleRepository.update writes name/description/permissions only, and
    // an inactive role's stored `permissions` must stay editable (it is what "Reactivar
    // rol" mints to every holder at once). unchanged('deletedAt') covers exactly that
    // no-op case — the null -> value transition can never satisfy it, so the stamp stays
    // pinned to request.time where it matters.
    function roleLifecycleSafe() {
      let d = request.resource.data;
      return ('active' in d) && (d.active is bool) && ('deletedAt' in d)
        && (d.active == true ? d.deletedAt == null
                            : d.deletedAt is timestamp
                              && (unchanged('deletedAt') || d.deletedAt == request.time));
    }
    // roleDefinitionDocSchema (packages/types/src/role-definition-doc-schema.ts) requires
    // EIGHT well-formed fields, pinned in three places — so read all three before concluding
    // this guard is schema-complete on its own:
    //   `active` / `deletedAt`  — roleLifecycleSafe() above.
    //   `name` / `description` / `permissions` / `locked` — this helper, applied to the
    //     create AND update arms so their SHAPE checks cannot drift apart.
    //   `builtIn` / `builtInKey` — pinned by VALUE, not shape: literals on create, and
    //     roleIdentityUnchanged() on update, which admits only a value equal to the
    //     resource's, so no off-type or off-enum value is client-introducible.
    //
    // Why SHAPE belongs in an authorization rule: this repo's two readers of a role doc
    // disagree about what malformed means. parseDocs DROPS a doc that fails the zod schema
    // (client-side console.error only), so /permisos re-renders that role through its
    // `unsynced` branch showing the SEED perms — while beacon's getRoleDocsByBuiltInKeys /
    // getRolesByIds read the raw doc and mint its REAL `permissions`. So an Admin write of
    // `{name: 42, permissions: ['manage:all']}`, or a create omitting `name`/`locked`
    // entirely, produces a role that is INVISIBLE on the page whose job is to show every
    // power grant while LIVE in the perms pipeline indefinitely. Each type check here is
    // the only thing between an Admin write and that ghost:
    //   name / description  is string  -> z.string() rejects a number, doc vanishes;
    //   permissions         is list    -> z.array() rejects a scalar, same;
    //   locked              is bool    -> z.boolean() rejects anything else, same.
    // `name.size() >= 1` mirrors roleDefinitionSchema's `.min(1)` (the WRITE schema).
    // `<= 100` has NO zod counterpart — a rules-only storage bound, the same ceiling this
    // file already uses for `leads.name`, and ~6x the longest real label ("Comité
    // Ejecutivo", 16 chars). roleDefinitionSchema's PERMISSION_CAP is deliberately NOT
    // mirrored: it is a curation bound with no ghost consequence (an over-cap role is
    // visible and merely fail-closes its holders), and hardcoding 30 here with no drift
    // guard behind it is the claim-without-a-check guardrail #6 forbids.
    // A list whose ELEMENTS are not strings cannot be caught here — rules have no
    // element-wise quantifier. That ghost is closed on the READER side instead:
    // roleDefinitionDocSchema now filters invalid codes rather than rejecting the whole doc,
    // mirroring permsFromRoleDoc, so both readers of `permissions` compute the same set and
    // no such doc can be invisible on /permisos while live in the perms pipeline. Fixing it
    // here would have meant hardcoding all 78 permission codes in rules — a claim with no
    // drift guard behind it, which is what guardrail #6 forbids.
    //
    // The `in` checks carry roleLifecycleSafe's cost: a legacy role doc missing any of the
    // four becomes admin-SDK-only to edit. Accepted — the alternative is a rule that cannot
    // tell a legacy doc from a forged one. `locked` in particular must be `in`-checked and
    // not read through `.get('locked', false)`: an omitted `locked` satisfied that default,
    // and roleIdentityUnchanged() then pinned it absent forever.
    // Which of these conjuncts a mutation sweep can actually turn red, measured rather than
    // asserted (each neutralized to `true` in turn, full suite re-run):
    //   RED alone      — name.size() >= 1, name.size() <= 100, description is string,
    //                    permissions is list, and each arm's roleShapeValid() call site.
    //   RED only jointly — the `name is string`/`size()` triple (a non-string `name` is
    //                    caught by .size() ERRORING once `is string` is gone, so `is string`
    //                    alone reads green; drop all three and the `name: 42` tests go red)
    //                    and the `('locked' in d)`/`locked is bool` pair (same reason).
    //   NEVER red      — the four `in` checks and `locked is bool`. An absent-key read errors
    //                    and an erroring rule already denies, so removing them makes nothing
    //                    ALLOWED; they buy a clean denial, not a guard. `locked is bool` is
    //                    additionally redundant today because both arms pin the VALUE
    //                    (`locked == false` on create, unchanged('locked') over a
    //                    `locked == false` resource on update) — it goes live only if that
    //                    loosens. Recorded so nobody counts them as coverage (guardrail #6).
    // One conjunct per line so a sweep can neutralize each in isolation — the leads-create
    // arm below carries a byte-identical `name` triple on a single line.
    function roleShapeValid() {
      let d = request.resource.data;
      return ('name' in d)
        && d.name is string
        && d.name.size() >= 1
        && d.name.size() <= 100
        && ('description' in d)
        && d.description is string
        && ('permissions' in d)
        && d.permissions is list
        && ('locked' in d)
        && d.locked is bool;
    }
    // Two built-in keys must never go inactive, for DIFFERENT reasons — named separately so
    // neither rationale is lost to a refactor:
    //   Member — computeMemberRoles injects "Member" into every claim unconditionally
    //     (compute-roles.ts:9), so deactivating it strips read:Member / read:MemberPoints /
    //     read:Activity / read:Program / read:Project from every provisioned user in the
    //     chapter via an unbounded, no-retry members scan (index.ts:298), collapsing nav and
    //     route access chapter-wide. An admin who wants that empties its `permissions`
    //     instead — no lifecycle asymmetry, still visible on /permisos. NOT the same effect,
    //     though: packages/auth/src/ability.ts confers CASL grants keyed on the Member role
    //     NAME, and those survive an emptied permissions array, so the UI keeps offering
    //     surfaces whose writes the rules then deny. The better of two imperfect options.
    //   Admin — anti-lockout. `locked: true` is the intended guard and the seed sets it, but
    //     prod role docs are documented in this repo as lagging the seed. Resting
    //     anti-lockout on `locked` alone turns it into a manual pre-deploy instruction with
    //     nothing behind it (guardrail #6): if prod's roles/Admin has `locked` missing or
    //     false, one Admin write deactivates it and strips manage:all chapter-wide through
    //     that same fan-out. Structural, keyed on builtInKey like the Member bar.
    // Both are RULES guards, so the admin SDK and the Firebase console still bypass them —
    // residual documented in docs/specs/role-lifecycle.md.
    function roleDeactivationAllowed() {
      let key = resource.data.get('builtInKey', null);
      return request.resource.data.get('active', true) == true
        || (key != 'Member' && key != 'Admin');
    }
    // Role definitions (editable RBAC). Permission sets here feed Auth custom claims
    // via the beacon onRoleWritten trigger, so writes are Admin-only — the same trust
    // boundary as positions.grants. Signed-in read so the admin UI can render role
    // names + the per-member effective-perms preview.
    match /roles/{roleId} {
      allow read: if signedIn();
      // Clients author CUSTOM roles only; built-ins are seeded via the admin SDK
      // (bypasses rules). Forbidding builtIn/builtInKey on client create closes the
      // impostor that spoofs a built-in key to double-grant perms in the trigger.
      allow create: if hasAnyRole(['Admin'])
        && roleShapeValid()
        && request.resource.data.builtIn == false
        && request.resource.data.builtInKey == null
        && request.resource.data.get('locked', false) == false
        && bornLive();
      // A `locked` role is immutable. Identity fields can't change. Every write must leave
      // a doc that BOTH readers agree on (roleShapeValid + roleLifecycleSafe). A built-in
      // role MAY otherwise be deactivated and reactivated — the perms consequence is
      // handled by beacon's three-way resolution (an inactive doc covers its key and
      // contributes nothing), not by a rules ban. The two exceptions, and why each is
      // keyed on builtInKey rather than on `locked`, are in roleDeactivationAllowed().
      allow update: if hasAnyRole(['Admin'])
        && resource.data.get('locked', false) == false
        && roleIdentityUnchanged()
        && roleShapeValid()
        && roleLifecycleSafe()
        && roleDeactivationAllowed();
      allow delete: if false;
    }

    match /allies/{allyId} {
      allow read: if canDo('read', 'Ally');
      allow create: if canDo('create', 'Ally') && bornLive();
      allow update: if canDo('update', 'Ally') && softDeleteSafe();
      allow delete: if false;
    }

    match /pointRules/{ruleId} {
      allow read: if signedIn();
      allow create: if canDo('create', 'PointRule');
      allow update: if canDo('update', 'PointRule');
      allow delete: if false;
    }

    match /terms/{termId} {
      allow read: if signedIn();
      allow create, update: if hasAnyRole(['Admin']);
      allow delete: if false;
    }

    // A parented activity inherits its parent initiative's direction. Standalone
    // activities (parentId == null) stay Admin/ProjectManager-only. Organizers-as-
    // individuals are not honored (rules can't iterate the array; no uid mirror).
    function activityParentDirection() {
      let coll = resource.data.get('parentType', '') == 'Program' ? 'programs' : 'projects';
      return signedIn()
        && resource.data.get('parentId', null) != null
        && request.auth.uid in get(
             /databases/$(database)/documents/$(coll)/$(resource.data.parentId)
           ).data.get('directionUids', []);
    }

    // Once an activity has check-ins, the fields that feed the points derivation
    // (category → point rule, startAt → punctuality factor, parentId/parentType →
    // rule resolution + report gate, termId → point-rule table + aggregate bucket)
    // are locked for EVERY client writer — mutating them would silently change
    // what already-awarded points mean. Rules cannot query checkIns, so beacon's
    // awardPoints trigger mirrors their existence onto the activity doc as
    // `hasCheckIns` (recomputed from a count() per checkIns write; admin SDK
    // bypasses these rules). The flag lands with trigger latency — the client
    // repository's live-count guard covers that window; this gate closes the
    // persistent bypass. Legacy docs without the field read as unlocked.
    function activityLockSafe() {
      return resource.data.get('hasCheckIns', false) != true
        || (unchanged('category')
            && unchanged('startAt')
            && unchanged('parentId')
            && unchanged('parentType')
            && unchanged('termId'));
    }

    match /activities/{activityId} {
      allow read: if signedIn();
      // hasCheckIns is beacon-owned: clients may never set it (create) or touch
      // it (update) — a forged true self-locks, a forged false unlocks the gate.
      allow create: if canDo('create', 'Activity')
        && !('hasCheckIns' in request.resource.data);
      allow update: if (canDo('update', 'Activity') || activityParentDirection())
        && unchanged('hasCheckIns')
        && activityLockSafe();
      allow delete: if false;
    }

    match /programs/{programId} {
      allow read: if signedIn();
      allow create: if initiativeCreateAllowed('Program');
      allow update: if initiativeUpdateAllowed('Program');
      allow delete: if false;
    }

    // Two timestamps fall on the same Bolivia-local (UTC-4, no DST) calendar day.
    // Mirrored client-side in apps/backstage/.../lib/check-in-window.ts — keep in sync.
    function sameBoliviaDay(a, b) {
      let la = a - duration.time(4, 0, 0, 0);
      let lb = b - duration.time(4, 0, 0, 0);
      return la.year() == lb.year() && la.month() == lb.month() && la.day() == lb.day();
    }
    // A check-in is only valid on the activity's own Bolivia day, while the
    // activity is not Cancelada and its parent initiative is not Finalizado.
    // A parented activity must carry a known parentType — anything else is
    // malformed and fails closed (parentOpen == false → deny).
    // Admin may backdate an attendance correction, so the same-day constraint is
    // lifted for them. The Cancelada and parent-Finalizado guards stay in force for
    // everyone — those protect locked/awarded points, not the check-in clock.
    function checkInDayOpen(act) {
      return hasAnyRole(['Admin']) || sameBoliviaDay(request.time, act.startAt);
    }
    function withinCheckInWindow(activityId) {
      let act = get(/databases/$(database)/documents/activities/$(activityId)).data;
      let parentColl = act.get('parentType', '') == 'Program' ? 'programs' : 'projects';
      let parentOpen = act.get('parentId', null) == null
        || (act.get('parentType', '') in ['Program', 'Project']
            && get(/databases/$(database)/documents/$(parentColl)/$(act.parentId))
                 .data.get('status', '') != 'Finalizado');
      return act.get('status', '') != 'Cancelada'
        && checkInDayOpen(act)
        && parentOpen;
    }

    match /checkIns/{checkInId} {
      // Every check-in author holds checkIn:Attendance (Admin/PM/ActivityManager/Scanner or
      // a custom role) and is bound to the activity's check-in window. A Scanner is then
      // confined to Attendee rows on top of that — a CONJUNCT, not an alternative arm,
      // because Scanner now holds the same coarse perm everyone else does: an OR would let
      // that perm satisfy the gate and skip the restriction entirely (a scanner self-awarding
      // 10-pt Director rows). manage:Attendance is the explicit escape hatch for a custom
      // role that legitimately manages the whole roster. exists() rides in the Scanner
      // conjunct — it was the Scanner arm's phantom-member guard and stays Scanner-scoped.
      allow read: if signedIn();
      allow create: if withinCheckInWindow(request.resource.data.activityId)
        && canDo('checkIn', 'Attendance')
        && (!hasAnyRole(['Scanner'])
            || canDo('manage', 'Attendance')
            || (request.resource.data.role == 'Attendee'
                && exists(/databases/$(database)/documents/members/$(request.resource.data.memberId))));
      // Undo a check-in (mis-scan correction). Same authority + window binding as create,
      // but read from the existing doc (resource.data) since delete carries no
      // request.resource — so the Attendee conjunct reads resource.data.role.
      allow delete: if withinCheckInWindow(resource.data.activityId)
        && canDo('checkIn', 'Attendance')
        && (!hasAnyRole(['Scanner'])
            || canDo('manage', 'Attendance')
            || resource.data.role == 'Attendee');
      allow update: if false;
    }

    // Engine-written ledger (beacon admin SDK). Client read-only — the member
    // profile + leaderboard surface it; the points table is member-visible.
    match /participations/{participationId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /memberPoints/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Curated public projection of completed initiatives (beacon admin SDK writes;
    // the public marketing site reads it without auth). Curated fields only — no raw
    // initiative/member data. See docs/specs/2026-06-12-spotlight-impacto-showcase-design.md
    match /showcase/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Curated public projection of allies (beacon admin SDK writes from onAllyWritten;
    // the public marketing site reads it without auth). Public fields only —
    // name + logoUrl + category; contactPerson/phone/email never leave /allies.
    match /allyShowcase/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Curated public projection of the current-term board (beacon admin SDK writes
    // from onBoardMemberWritten; the public marketing site reads it without auth).
    // Public fields only — name + role title + group + Storage photo URL; grants/PII
    // never leave /members. Membership keys on members.publicProfile: beacon stamps it
    // true on members created from 2026-08 on (opt-out), while older docs have no key and
    // stay unpublished until their owner opts in. Only the owner turns it on; the owner
    // or an Admin (takedown arm) turns it off.
    match /boardShowcase/{id} {
      allow read: if true;
      allow write: if false;
    }

    // World-read singleton doc for the public marketing site; only Admin may
    // edit org facts (stats, allies, timeline, MVV, reasons, contact) via backstage.
    match /siteConfig/current {
      allow read: if true;
      allow write: if hasAnyRole(['Admin']);
    }

    // Public lead capture (spotlight contact form). Unauthenticated visitors may
    // CREATE a well-formed lead — the repo's only public write surface — but never
    // read (leads carry PII emails). Admins (read:Lead / manage:all) triage them in
    // the backstage Prospectos inbox.
    //
    // The strict schema gate below bounds a lead's SHAPE (field set, sizes, enum
    // pins). Volume/abuse mitigation is now handled at the product layer: App Check
    // enforcement is ENABLED for Firestore, so a tokenless (bot) write is rejected
    // before these rules even evaluate, while the spotlight contact form sends a
    // valid reCAPTCHA-v3 token via getFirestoreLite's initAppCheck. That closes the
    // "tracked fast-follow" from the design spec. A rules-level `request.app != null`
    // gate would be redundant with enforcement AND untestable here — the pinned
    // @firebase/rules-unit-testing has no App Check token injection, so it would only
    // break the anon-create success tests below. See
    // docs/specs/2026-07-10-lead-capture-hub-design.md and docs/firebase-setup.md.
    //
    // intent/status literals mirror LEAD_INTENTS/LEAD_STATUSES in
    // packages/types/src/lead.ts — keep in sync (a TS-only addition silently drifts).
    function leadCreateValid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'phone', 'intent', 'message', 'status', 'source', 'createdAt', 'deletedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 100
        && d.email is string && d.email.size() >= 1 && d.email.size() <= 200
        // phone is optional (WhatsApp contact); when present it must be a bounded string.
        && (!('phone' in d) || (d.phone is string && d.phone.size() >= 1 && d.phone.size() <= 20))
        && d.message is string && d.message.size() >= 1 && d.message.size() <= 2000
        && d.intent in ['Membresía', 'Alianza', 'Prensa', 'Otro']
        && d.status == 'Nuevo'
        && d.source == 'web'
        && d.createdAt == request.time
        // Require the key present (not just .get-absent) so every lead carries a
        // deletedAt — a doc missing the key would pass here but break leadDocSchema
        // on read (PR3 inbox), a zero-auth way to make a lead silently disappear.
        && 'deletedAt' in d && d.deletedAt == null;
    }
    match /leads/{leadId} {
      allow create: if leadCreateValid();
      allow read: if canDo('read', 'Lead');
      // Triage only: an admin advances the pipeline (status) or soft-deletes
      // (deletedAt, immutable once set). The submitted PII (name/email/message) is
      // never client-mutable. `leads` has no `active` field, so softDeleteSafe()
      // (which reads resource.data.active) can't be reused — guard deletedAt directly.
      // 'deletedAt' in ... forbids stripping the key via deleteField() (would break
      // leadDocSchema on read, same drift as the create guard closes).
      allow update: if canDo('update', 'Lead')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedAt'])
        && request.resource.data.status in ['Nuevo', 'Contactado', 'Cerrado']
        && 'deletedAt' in request.resource.data
        && (resource.data.get('deletedAt', null) == null || unchanged('deletedAt'));
      allow delete: if false;
    }

    // Composed notifications: only a create:Notification holder may compose; the
    // create is the send trigger's input. stats is Admin-SDK-written (bypasses
    // rules), so it must be absent on the client create. No client update/delete.
    match /notifications/{id} {
      allow read: if canDo('read', 'Notification');
      allow create: if canDo('create', 'Notification')
        && request.resource.data.keys().hasOnly(['title', 'body', 'url', 'audience', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.audience.type in ['everyone', 'members', 'role']
        && (request.resource.data.audience.type != 'role'
            || (request.resource.data.audience.roleId is string
                && request.resource.data.audience.roleId.size() > 0))
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 1000
        && (request.resource.data.url == null
            || (request.resource.data.url is string && request.resource.data.url.size() <= 2000));
      allow update, delete: if false;
    }

    // Per-member inbox fan-out. Admin-SDK writes the copies; the owner may read
    // and may flip ONLY `read`. INBOX_MUTABLE_FIELDS in @luminova/types mirrors
    // this hasOnly(['read']) — kept in lockstep by a rules cross-check test.
    match /members/{memberId}/notifications/{id} {
      allow read: if signedIn() && request.auth.uid == memberId;
      allow update: if signedIn() && request.auth.uid == memberId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow create, delete: if false;
    }

    // A member's FCM device tokens. Owner-only; token id is the token string.
    match /members/{memberId}/fcmTokens/{token} {
      allow read, delete: if signedIn() && request.auth.uid == memberId;
      allow create: if signedIn() && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // Anonymous spotlight device tokens. The doc id IS the FCM token — a high-entropy
    // capability string; there is no anon identity to scope to, so create is public
    // (bounded shape, no PII) and delete is open (holding the token = controlling that
    // device's subscription; there is no read/list to enumerate ids). Mirrors `leads`
    // as a public-writable, no-PII collection.
    match /pushTokens/{token} {
      allow create: if request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow delete: if true;
      allow read, update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
