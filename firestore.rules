rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function roles() {
      return request.auth.token.roles;
    }
    function hasAnyRole(rs) {
      return signedIn() && roles().hasAny(rs);
    }
    function unchanged(field) {
      // .get(...) so an ABSENT field (e.g. uid on an un-invited member) compares as
      // null instead of throwing "Property is undefined" — which denied every update
      // to a member without a uid. Immutability holds: null != a set value.
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }
    // Block client-side resurrection of soft-deleted docs: once deletedAt is set
    // it is immutable, and active can only transition true -> false, never back.
    function softDeleteSafe() {
      return (resource.data.deletedAt == null || unchanged('deletedAt'))
        && (resource.data.active == true || unchanged('active'));
    }

    // Missing-key-safe comparison (docs created before a field existed).
    function unchangedOrAbsent(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }
    // The initiative's direction: director + co-directors, mirrored to uids by beacon.
    function isDirection() {
      return signedIn() && request.auth.uid in resource.data.get('directionUids', []);
    }
    // directionUids is beacon-written; termId is immutable; once the final report
    // is filed the completion trio (finalReport/status/impact) is locked — clearing
    // the report would silently un-confirm awarded points.
    function initiativeWriteSafe() {
      return unchangedOrAbsent('directionUids')
        && unchangedOrAbsent('termId')
        && (resource.data.get('finalReport', null) == null
            || (unchangedOrAbsent('finalReport')
                && unchangedOrAbsent('status')
                && unchangedOrAbsent('impact')));
    }

    // Rules derive the current term from request.time.year() (UTC int) so they can
    // locate positions.<term> without iterating map keys — matches the app's
    // currentTermKey() = getUTCFullYear().
    function currentTermKey() {
      return string(request.time.year());
    }
    function assignedTerm() {
      return request.resource.data.get('positions', {}).get(currentTermKey(), {});
    }
    function assignedBySelf() {
      return assignedTerm().get('assignedBy', '') == request.auth.uid;
    }
    function assignedCargoId() {
      return assignedTerm().get('cargoId', null);
    }
    // A null cargoId short-circuits (no get). For a non-null cargoId, get() on a
    // missing position errors → rule denies (fail-closed). Comisión grants are not
    // checked here (rules can't iterate the array) — the beacon trust gate is their backstop.
    function cargoGrantsEmpty() {
      return assignedCargoId() == null
        || get(/databases/$(database)/documents/positions/$(assignedCargoId())).data.grants.size() == 0;
    }
    function positionsTouched() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['positions']);
    }
    function positionsDelta() {
      return request.resource.data.get('positions', {})
        .diff(resource.data.get('positions', {}))
        .affectedKeys();
    }
    // A positions write is well-formed when the ONLY changed term key is the current
    // one (past terms are read-only for ALL client writes, Admin included — historical
    // edits are an admin-SDK/console op), the writer stamped themselves, and either they
    // are Admin or the assigned cargo confers no power. Restricting to the current term
    // also closes a ride-along: a non-Admin can no longer sneak a power cargo + forged
    // assignedBy under a different term key in the same write. Comisión power grants are
    // not loop-checkable here — the beacon claims-sync trust gate is their backstop.
    function positionsAssignmentSafe() {
      return positionsDelta().hasOnly([currentTermKey()])
        && assignedBySelf()
        && (hasAnyRole(['Admin']) || cargoGrantsEmpty());
    }
    // Create has no prior resource to diff, so it can't use positionsDelta(); it
    // applies the same self-stamp + power-cargo-Admin-only gate to any positions it
    // writes. Without this a Membership user could create a member with a forged
    // assignedBy = a known Admin's uid + a power cargo; the claims-sync trigger would
    // then honor the grant and mint Admin onto that member's (or the attacker's) uid.
    function createPositionsSafe() {
      return !('positions' in request.resource.data)
        || (assignedBySelf() && (hasAnyRole(['Admin']) || cargoGrantsEmpty()));
    }

    // The completion trio is written atomically by the wizard; a bare status flip to
    // Finalizado (no report) would orphan child-activity point confirmation. Enforce
    // the report is present in the same write. Create already forbids Finalizado.
    function finalizedRequiresReport() {
      return request.resource.data.get('status', '') != 'Finalizado'
        || request.resource.data.get('finalReport', null) != null;
    }

    function initiativeCreateAllowed() {
      return hasAnyRole(['Admin', 'ProjectManager'])
        && request.resource.data.get('directionUids', []) == []
        && request.resource.data.get('finalReport', null) == null
        && request.resource.data.get('impact', null) == null
        && request.resource.data.get('status', '') != 'Finalizado';
    }
    function initiativeUpdateAllowed() {
      return (hasAnyRole(['Admin', 'ProjectManager']) || isDirection())
        && initiativeWriteSafe()
        && finalizedRequiresReport();
    }

    match /projects/{projectId} {
      // D1 added member-id rosters to projects; restrict to signed-in (was public).
      // C4's Spotlight projection will expose curated public fields, not raw docs.
      allow read: if signedIn();
      allow create: if initiativeCreateAllowed();
      allow update: if initiativeUpdateAllowed();
      allow delete: if false;
    }

    match /board/{boardId} {
      allow read: if true;
      allow create, update: if hasAnyRole(['Admin']);
      allow delete: if false;
    }

    match /members/{memberId} {
      allow read: if hasAnyRole(['Admin', 'Membership', 'Treasury', 'ExecutiveCommittee'])
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if hasAnyRole(['Admin', 'Membership'])
        && request.resource.data.totalPoints == 0
        && !('uid' in request.resource.data)
        && createPositionsSafe();
      allow update: if hasAnyRole(['Admin', 'Membership'])
        && unchanged('totalPoints')
        && unchanged('uid')
        && softDeleteSafe()
        && (!positionsTouched() || positionsAssignmentSafe());
      // A member may set only their own profilePicture (H1 self-upload on /me).
      // .get('uid', '') so a member doc WITHOUT a uid compares false instead of
      // throwing — an erroring allow-rule must not deny an otherwise-valid update.
      allow update: if signedIn()
        && resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profilePicture'])
        && softDeleteSafe();
      // ExecutiveCommittee may edit only position assignments (org chart), nothing else.
      allow update: if hasAnyRole(['ExecutiveCommittee'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['positions'])
        && softDeleteSafe()
        && positionsAssignmentSafe();
      allow delete: if false;
    }

    // grants feed Auth custom claims (K4 trigger) — only Admin may confer power,
    // else ExecutiveCommittee could mint an Admin-granting cargo for itself.
    match /positions/{positionId} {
      allow read: if signedIn();
      allow create: if hasAnyRole(['Admin'])
        || (hasAnyRole(['ExecutiveCommittee']) && request.resource.data.grants == []);
      allow update: if (hasAnyRole(['Admin'])
          || (hasAnyRole(['ExecutiveCommittee']) && unchanged('grants')))
        && softDeleteSafe();
      allow delete: if false;
    }

    match /allies/{allyId} {
      allow read: if hasAnyRole(['Admin', 'Membership', 'ProjectManager', 'ExecutiveCommittee']);
      allow create: if hasAnyRole(['Admin', 'Membership']);
      allow update: if hasAnyRole(['Admin', 'Membership']) && softDeleteSafe();
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update: if hasAnyRole(['Admin', 'ExecutiveCommittee', 'ProjectManager']);
      allow delete: if false;
    }

    match /pointRules/{ruleId} {
      allow read: if signedIn();
      allow create, update: if hasAnyRole(['Admin']);
      allow delete: if false;
    }

    match /terms/{termId} {
      allow read: if signedIn();
      allow create, update: if hasAnyRole(['Admin']);
      allow delete: if false;
    }

    match /activities/{activityId} {
      allow read: if signedIn();
      allow create, update: if hasAnyRole(['Admin', 'ProjectManager']);
      allow delete: if false;
    }

    match /programs/{programId} {
      allow read: if signedIn();
      allow create: if initiativeCreateAllowed();
      allow update: if initiativeUpdateAllowed();
      allow delete: if false;
    }

    match /checkIns/{checkInId} {
      allow read: if signedIn();
      // Admin/ProjectManager may register any role; a Scanner may only register
      // attendance for its assigned activities (never director/team — that would
      // self-award high-value points).
      allow create: if hasAnyRole(['Admin', 'ProjectManager'])
        || (hasAnyRole(['Scanner'])
            && request.resource.data.role == 'Attendee'
            && request.resource.data.activityId in request.auth.token.scannerEventIds
            && exists(/databases/$(database)/documents/members/$(request.resource.data.memberId)));
      allow update, delete: if false;
    }

    // Engine-written ledger (beacon admin SDK). Client read-only — the member
    // profile + leaderboard surface it; the points table is member-visible.
    match /participations/{participationId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /memberPoints/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
