{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "VITE_FIREBASE_EMULATOR_ENABLED",
        "BRAND_PROFILE",
        "BRAND_RELEASE",
        "BRAND_ASSETS_DIR",
        "GCP_PROJECT_ID"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/luminova.json",
        "$TURBO_ROOT$/brand/**",
        "$TURBO_ROOT$/brand-assets/**"
      ]
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/luminova.json", "$TURBO_ROOT$/brand/**"]
    },
    "ci": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/luminova.json", "$TURBO_ROOT$/brand/**"]
    }
  }
}
