# Optional: pnpm dev needs no .env.local. It reads the Firebase config from the brand profile
# luminova.json selects and connects to the local emulators. Copy this file to .env.local
# only to override one of these.

# Point the dev server at the profile's real Firebase project instead of the emulators:
# VITE_FIREBASE_EMULATOR_ENABLED=false

# Against the emulators, App Check and web push are off (the profile's production keys do
# not work on localhost). Set a debug-capable key here to try them locally:
# VITE_APPCHECK_SITE_KEY=
# VITE_FIREBASE_VAPID_KEY=
