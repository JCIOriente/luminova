{
  "name": "spotlight",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/spotlight/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project spotlight --web",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "configFile": "apps/spotlight/vite.config.ts",
        "outputPath": "dist/apps/spotlight"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "spotlight:build"
      },
      "configurations": {
        "development": {
          "hmr": true
        },
        "production": {
          "buildTarget": "spotlight:build:production"
        }
      }
    },
    "preview": {
      "executor": "@nx/vite:preview",
      "options": {
        "buildTarget": "spotlight:build"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "configFile": "apps/spotlight/vite.config.ts",
        "passWithNoTests": true,
        "reportsDirectory": "coverage/apps/spotlight"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/spotlight/**/*.{ts,tsx,js,jsx}"
        ]
      }
    }
  }
}
