    "seed:roles": "node --experimental-strip-types scripts/seed-roles.ts"
  },
  "dependencies": {
    "@luminova/auth": "workspace:*",
    "@luminova/types": "workspace:*",
    "firebase-admin": "13.10.0",
    "firebase-functions": "7.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0"
  }
}
