# backstage web app (appId ...d88b4acf) — admin dashboard, PRODUCTION build.
# Firebase web API keys are public client identifiers, not secrets — safe to commit.
# Loaded by `vite build` (mode=production). Deploy scripts also force EMULATOR_ENABLED=false
# so a developer's .env.local (emulator on) can never leak into a prod bundle.
VITE_FIREBASE_API_KEY=AIzaSyDdLctu49oDf2sKidnwlGtkhEeJYP3veMg
VITE_FIREBASE_AUTH_DOMAIN=jci-oriente.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jci-oriente
VITE_FIREBASE_STORAGE_BUCKET=jci-oriente.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=953870918238
VITE_FIREBASE_APP_ID=1:953870918238:web:acbd53d377846bd88b4acf
VITE_FIREBASE_EMULATOR_ENABLED=false
# App Check (reCAPTCHA v3) — paste the real site key once created in console; blank disables App Check.
VITE_APPCHECK_SITE_KEY=
