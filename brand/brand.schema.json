{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "This profile's folder name under brand/; luminova.json selects it."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "The chapter's name as people say it, e.g. JCI Oriente."
    },
    "shortName": {
      "type": "string",
      "minLength": 1,
      "description": "A short form for tight places (app name on a phone's home screen)."
    },
    "legalName": {
      "type": "string",
      "minLength": 1,
      "description": "The registered legal name, for the footer and legal pages."
    },
    "movementName": {
      "type": "string",
      "minLength": 1,
      "description": "The movement's name in your language, e.g. Cámara Junior Internacional."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "One line about the chapter, used in the web app manifest."
    },
    "locality": {
      "description": "Where the chapter is; the site's copy uses these words.",
      "type": "object",
      "properties": {
        "city": {
          "type": "string",
          "minLength": 1,
          "description": "City as used in a sentence, e.g. Santa Cruz."
        },
        "cityFormal": {
          "type": "string",
          "minLength": 1,
          "description": "The city's formal name, e.g. Santa Cruz de la Sierra."
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "description": "Region as used in a sentence, e.g. el Oriente boliviano."
        },
        "regionShort": {
          "description": "Optional short region, e.g. el Oriente. Blank means the same as region.",
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1,
          "description": "Country, e.g. Bolivia."
        }
      },
      "required": [
        "city",
        "cityFormal",
        "region",
        "country"
      ],
      "additionalProperties": false
    },
    "foundedYear": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100,
      "description": "Year the chapter was founded."
    },
    "stats": {
      "type": "object",
      "properties": {
        "nationalOrganizations": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "nationalOrganizations"
      ],
      "additionalProperties": false,
      "description": "Numbers the home page states. nationalOrganizations: local organizations in the national federation."
    },
    "parentOrganization": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "additionalProperties": false,
      "description": "The national federation the site links to."
    },
    "broadcastChannelName": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the chapter's WhatsApp broadcast channel."
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
      "description": "The site's language tag, e.g. es."
    },
    "ogLocale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}_[A-Z]{2}$",
      "description": "Language and country for link previews, e.g. es_BO."
    },
    "urls": {
      "type": "object",
      "properties": {
        "spotlight": {
          "type": "string",
          "minLength": 1
        },
        "backstage": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "spotlight",
        "backstage"
      ],
      "additionalProperties": false,
      "description": "Public addresses: spotlight is the public site, backstage the admin site. Bare https origins, no path."
    },
    "qrPrefix": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Prefix inside member QR credentials. Never change it once credentials are issued: old QR codes would stop scanning."
    },
    "themeColor": {
      "type": "object",
      "properties": {
        "spotlight": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "backstage": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "spotlight",
        "backstage"
      ],
      "additionalProperties": false,
      "description": "Browser and home-screen color of each site, #RRGGBB."
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "ogTitle": {
          "type": "string",
          "minLength": 1
        },
        "ogDescription": {
          "type": "string",
          "minLength": 1
        },
        "ogImageAlt": {
          "type": "string",
          "minLength": 1
        },
        "twitterDescription": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "description",
        "ogTitle",
        "ogDescription",
        "ogImageAlt",
        "twitterDescription"
      ],
      "additionalProperties": false,
      "description": "What search engines and link previews (WhatsApp, Facebook, X) show for the public site."
    },
    "backstage": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "emailPlaceholder": {
          "type": "string",
          "minLength": 1
        },
        "contactEmail": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        }
      },
      "required": [
        "title",
        "emailPlaceholder",
        "contactEmail"
      ],
      "additionalProperties": false,
      "description": "Admin site texts. contactEmail is where a member without an account asks for access."
    },
    "og": {
      "default": {
        "legacyPaths": []
      },
      "description": "Old share-image file names that must keep working because apps cached them.",
      "type": "object",
      "properties": {
        "legacyPaths": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.png$"
          }
        }
      },
      "additionalProperties": false
    },
    "firebase": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
          "description": "Your Firebase project id (Firebase console → Project settings). Builds and deploys target it."
        },
        "storageBucket": {
          "type": "string",
          "minLength": 1,
          "description": "The project's Cloud Storage bucket, usually <projectId>.firebasestorage.app."
        },
        "sites": {
          "type": "object",
          "properties": {
            "spotlight": {
              "type": "string",
              "minLength": 1
            },
            "backstage": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "spotlight",
            "backstage"
          ],
          "additionalProperties": false,
          "description": "Firebase Hosting site ids for the public and the admin site."
        },
        "web": {
          "type": "object",
          "properties": {
            "authDomain": {
              "type": "string",
              "minLength": 1
            },
            "messagingSenderId": {
              "type": "string",
              "pattern": "^\\d+$"
            },
            "spotlight": {
              "type": "object",
              "properties": {
                "apiKey": {
                  "type": "string",
                  "minLength": 1
                },
                "appId": {
                  "type": "string",
                  "minLength": 1
                },
                "appCheckSiteKey": {
                  "type": "string"
                },
                "vapidKey": {
                  "type": "string"
                }
              },
              "required": [
                "apiKey",
                "appId",
                "appCheckSiteKey",
                "vapidKey"
              ],
              "additionalProperties": false
            },
            "backstage": {
              "type": "object",
              "properties": {
                "apiKey": {
                  "type": "string",
                  "minLength": 1
                },
                "appId": {
                  "type": "string",
                  "minLength": 1
                },
                "appCheckSiteKey": {
                  "type": "string"
                },
                "vapidKey": {
                  "type": "string"
                }
              },
              "required": [
                "apiKey",
                "appId",
                "appCheckSiteKey",
                "vapidKey"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "authDomain",
            "messagingSenderId",
            "spotlight",
            "backstage"
          ],
          "additionalProperties": false,
          "description": "Each web app's config from Firebase console → Project settings → Your apps. Public identifiers, not secrets. A blank appCheckSiteKey or vapidKey turns that feature off."
        }
      },
      "required": [
        "projectId",
        "storageBucket",
        "sites",
        "web"
      ],
      "additionalProperties": false,
      "description": "The Firebase project this chapter runs on."
    },
    "assetsBucket": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$",
      "description": "Private bucket holding the chapter's logos and icons for deploys, usually <projectId>-brand-assets. pnpm brand:provision creates it."
    },
    "deploy": {
      "type": "object",
      "properties": {
        "workloadIdentityProvider": {
          "type": "string",
          "pattern": "^projects\\/\\d+\\/locations\\/global\\/workloadIdentityPools\\/[a-z0-9-]+\\/providers\\/[a-z0-9-]+$",
          "description": "The Workload Identity provider CD signs in through, without a stored key. docs/ci-cd.md section 6 creates it; pnpm brand:provision prints the value."
        },
        "serviceAccount": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
          "description": "The service account CD deploys as, e.g. firebase-deployer@<projectId>.iam.gserviceaccount.com."
        }
      },
      "required": [
        "workloadIdentityProvider",
        "serviceAccount"
      ],
      "additionalProperties": false,
      "description": "How CD (GitHub Actions) signs in to Google Cloud. Names, not secrets: safe to commit. Needed only to deploy."
    }
  },
  "required": [
    "slug",
    "name",
    "shortName",
    "legalName",
    "movementName",
    "description",
    "locality",
    "foundedYear",
    "stats",
    "parentOrganization",
    "broadcastChannelName",
    "locale",
    "ogLocale",
    "urls",
    "qrPrefix",
    "themeColor",
    "seo",
    "backstage",
    "firebase",
    "assetsBucket"
  ],
  "additionalProperties": false,
  "description": "A chapter's brand profile: names, texts, addresses and the Firebase project. Every value here is public."
}
