{
  "name": "luminova",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "ci": "turbo run ci",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "knip": "knip",
    "audit": "pnpm audit --audit-level=high",
    "pr-tests": "pnpm format && turbo run ci && pnpm knip && pnpm audit --audit-level=high",
    "seed:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:4010 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:4030 node tools/scripts/seed-emulator.mjs",
    "build:spotlight:prod": "VITE_FIREBASE_EMULATOR_ENABLED=false pnpm --filter spotlight build",
    "build:backstage:prod": "VITE_FIREBASE_EMULATOR_ENABLED=false pnpm --filter backstage build",
    "deploy:rules": "firebase deploy --only firestore,storage",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "pnpm build:spotlight:prod && pnpm build:backstage:prod && firebase deploy --only hosting",
    "deploy:all": "pnpm deploy:rules && pnpm deploy:functions && pnpm deploy:hosting"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "firebase-admin": "13.10.0",
    "knip": "^6.15.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
