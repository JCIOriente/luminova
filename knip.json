{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["tailwindcss", "@fontsource-variable/plus-jakarta-sans"],
  "ignoreBinaries": ["firebase"],
  "ignore": ["tools/scripts/**"],
  "workspaces": {
    "apps/*": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "tests/*": {
      "entry": ["*.test.ts"],
      "project": ["**/*.ts"]
    }
  }
}
