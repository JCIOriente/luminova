{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["tailwindcss"],
  "ignoreBinaries": ["firebase"],
  "ignore": ["tools/scripts/**", ".claude/hooks/**"],
  "workspaces": {
    "apps/*": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/spotlight": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@fontsource-variable/plus-jakarta-sans"]
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "tests/*": {
      "entry": ["*.test.ts"],
      "project": ["**/*.ts"]
    }
  }
}
