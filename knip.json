{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["tailwindcss"],
  "ignoreBinaries": ["firebase"],
  "ignore": ["tools/scripts/**"],
  "workspaces": {
    "apps/*": {
      "entry": ["src/main.tsx", "src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/auth": {
      "entry": ["src/roles.ts", "src/ability.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "tests/*": {
      "entry": ["*.test.ts"],
      "project": ["**/*.ts"]
    }
  }
}
