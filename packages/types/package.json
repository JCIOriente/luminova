{
  "name": "@luminova/types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./src/engine/index.ts",
      "import": "./dist/engine/index.js",
      "default": "./dist/engine/index.js"
    },
    "./permission": {
      "types": "./src/permission.ts",
      "import": "./dist/permission.js",
      "default": "./dist/permission.js"
    },
    "./role-definition": {
      "types": "./src/role-definition.ts",
      "import": "./dist/role-definition.js",
      "default": "./dist/role-definition.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsc",
    "ci": "eslint . && tsc --noEmit && vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "firebase": "12.14.0"
  }
}
